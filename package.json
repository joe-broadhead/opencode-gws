{
  "name": "@joe-broadhead/opencode-gws",
  "version": "0.0.2",
  "description": "Unofficial OpenCode plugin for Google Workspace (gws CLI)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-gws.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-gws#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-gws/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "google-workspace"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "google-workspace",
      "name": "Google Workspace",
      "domain": "workspace.google.com"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "manifest/generated.json",
    "manifest/native.json",
    "licenses/gws",
    "views/calendar.html",
    "views/gmail-thread.html",
    "views/jelly-view.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check && node scripts/check-copies.mjs && node scripts/check-icons.mjs && node scripts/check-forbidden.mjs && node scripts/check-workflows.mjs",
    "test": "vitest run",
    "test:host": "vitest run -c vitest.host.config.ts",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:tui": "bun --conditions=browser test/tui-renderer.mjs",
    "test:kit": "node --test scripts/release-kit.test.mjs",
    "fetch:gws": "node scripts/build-native.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:kit && npm run test:host && npm run test:pack && npm run generated:check && npm run test:tui",
    "generated:check": "node scripts/generate-docs.mjs --check",
    "manifest": "node scripts/generate-manifest.mjs",
    "drift": "node scripts/drift.mjs",
    "docs:coverage": "node scripts/generate-docs.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/biome": "2.6.4",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "24.19.2",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "jelly": {
    "title": "Google Workspace",
    "summary": "Gmail, Calendar, Drive, Docs and Sheets.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "gws.status",
        "permission": "gws.status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.catalog",
        "permission": "gws.catalog",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.schema",
        "permission": "gws.schema",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.read",
        "permission": "gws.read",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.plan",
        "permission": "gws.plan",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.events_list",
        "permission": "gws.events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.write",
        "permission": "gws.write",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.export",
        "permission": "gws.export",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.send",
        "permission": "gws.send",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.share",
        "permission": "gws.share",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.delete",
        "permission": "gws.delete",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.admin",
        "permission": "gws.admin",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "opencode-gws",
      "opencode-gws-recipes"
    ],
    "rpc": [
      {
        "name": "calendar.today",
        "label": "read today's calendar",
        "permission": "gws.read",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account",
            "at",
            "state",
            "events"
          ],
          "properties": {
            "account": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "state": {
              "type": "string",
              "enum": [
                "ready",
                "stale"
              ]
            },
            "events": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "start",
                  "end"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "start": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "end": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "allDay": {
                    "type": "boolean"
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "joinUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "images.read",
        "label": "read a Google Workspace picture",
        "permission": "gws.read",
        "readOnly": true,
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 9,
              "maxLength": 2048
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mime",
            "base64"
          ],
          "properties": {
            "mime": {
              "type": "string",
              "enum": [
                "image/png",
                "image/jpeg",
                "image/gif",
                "image/webp"
              ]
            },
            "base64": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1398110
            }
          }
        }
      }
    ],
    "views": [
      {
        "v": 1,
        "id": "gmail-thread",
        "place": "tool-result",
        "tools": [
          "gws_read"
        ],
        "title": "Gmail thread",
        "page": "views/gmail-thread.html",
        "grants": [
          "data"
        ]
      },
      {
        "v": 1,
        "id": "calendar-native",
        "place": "home-widget",
        "size": "m",
        "title": "Today",
        "page": "views/calendar.html",
        "grants": [
          "rpc"
        ],
        "rpc": [
          "calendar.today"
        ]
      }
    ],
    "nativeData": [
      {
        "v": 1,
        "capability": "calendar",
        "view": "calendar-native",
        "read": "calendar.today"
      }
    ],
    "imageHosts": [
      "drive.google.com",
      "lh3.googleusercontent.com",
      "lh4.googleusercontent.com",
      "lh5.googleusercontent.com",
      "lh6.googleusercontent.com",
      "lh7.googleusercontent.com",
      "lh7-rt.googleusercontent.com",
      "lh7-us.googleusercontent.com"
    ],
    "imageRead": {
      "method": "images.read"
    },
    "signIns": [
      {
        "id": "google",
        "label": "Google Workspace",
        "integration": "gws-*",
        "relay": {
          "redirectField": "redirectUri",
          "portField": "callbackPort"
        },
        "account": {
          "option": "accounts",
          "label": "Account name",
          "description": "A short name for this Google account, such as work or personal. The agent names it on every call. It gets every Google service your sign-in can use; when you sign in you choose Read-only or Read and write.",
          "placeholder": "work",
          "value": {
            "mode": "interactive"
          }
        },
        "hostClient": {
          "id": "google",
          "field": "clientJson",
          "replaces": [
            "clientId",
            "clientSecret"
          ]
        },
        "needed": [
          "AUTH_REQUIRED",
          "AUTH_SCOPE_MISSING"
        ]
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "default": "all",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule; plan-then-commit still applies."
        }
      ]
    }
  }
}

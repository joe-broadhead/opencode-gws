{
  "name": "@joe-broadhead/opencode-gws",
  "version": "0.0.9",
  "description": "Unofficial OpenCode plugin for Google Workspace (gws CLI)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-gws.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-gws#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-gws/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "google-workspace"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "skills",
    "manifest/generated.json",
    "views/gmail-thread.html",
    "views/jelly-view.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check && node scripts/check-copies.mjs",
    "test": "vitest run",
    "test:host": "vitest run -c vitest.host.config.ts",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:tui": "bun --conditions=browser test/tui-renderer.mjs",
    "fetch:gws": "node scripts/fetch-gws.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:host && npm run test:pack && npm run generated:check && npm run test:tui",
    "generated:check": "node scripts/generate-docs.mjs --check",
    "manifest": "node scripts/generate-manifest.mjs",
    "drift": "node scripts/drift.mjs",
    "docs:coverage": "node scripts/generate-docs.mjs"
  },
  "optionalDependencies": {
    "@joe-broadhead/opencode-gws-bin-darwin-arm64": "0.0.9",
    "@joe-broadhead/opencode-gws-bin-darwin-x64": "0.0.9",
    "@joe-broadhead/opencode-gws-bin-linux-arm64-gnu": "0.0.9",
    "@joe-broadhead/opencode-gws-bin-linux-x64-gnu": "0.0.9"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/biome": "2.6.4",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opencode/theme": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "24.19.2",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "jelly": {
    "title": "Google Workspace",
    "summary": "Gmail, Calendar, Drive, Docs and Sheets.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "gws.status",
        "permission": "gws.status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.catalog",
        "permission": "gws.catalog",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.schema",
        "permission": "gws.schema",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.read",
        "permission": "gws.read",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.plan",
        "permission": "gws.plan",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.events_list",
        "permission": "gws.events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.write",
        "permission": "gws.write",
        "effect": "ask",
        "readOnly": false
      },
      {
        "name": "gws.export",
        "permission": "gws.export",
        "effect": "ask",
        "readOnly": false
      },
      {
        "name": "gws.send",
        "permission": "gws.send",
        "effect": "ask",
        "readOnly": false
      },
      {
        "name": "gws.share",
        "permission": "gws.share",
        "effect": "ask",
        "readOnly": false
      },
      {
        "name": "gws.delete",
        "permission": "gws.delete",
        "effect": "ask",
        "readOnly": false
      },
      {
        "name": "gws.admin",
        "permission": "gws.admin",
        "effect": "ask",
        "readOnly": false
      }
    ],
    "skills": [
      "opencode-gws",
      "opencode-gws-recipes"
    ],
    "rpc": [],
    "views": [
      {
        "v": 1,
        "id": "gmail-thread",
        "place": "tool-result",
        "tools": [
          "gws_read"
        ],
        "title": "Gmail thread",
        "page": "views/gmail-thread.html",
        "grants": [
          "data"
        ]
      }
    ],
    "signIns": [
      {
        "id": "google",
        "label": "Google Workspace",
        "integration": "gws-*",
        "relay": {
          "redirectField": "redirectUri",
          "portField": "callbackPort"
        },
        "account": {
          "option": "accounts",
          "label": "Account name",
          "description": "A short name for this Google account, such as work or personal. The agent names it on every call. It gets every Google service your sign-in can use; when you sign in you choose Read-only or Read and write.",
          "placeholder": "work",
          "value": {
            "mode": "interactive"
          }
        },
        "hostClient": {
          "id": "google",
          "field": "clientJson",
          "replaces": [
            "clientId",
            "clientSecret"
          ]
        },
        "needed": [
          "AUTH_REQUIRED",
          "AUTH_SCOPE_MISSING"
        ]
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": []
    }
  }
}

{
  "name": "@joe-broadhead/opencode-gws",
  "version": "0.0.2",
  "description": "Unofficial OpenCode plugin for Google Workspace (gws CLI)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-gws.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-gws#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-gws/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "google-workspace"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "google-workspace",
      "name": "Google Workspace",
      "domain": "workspace.google.com"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "manifest/generated.json",
    "manifest/native.json",
    "licenses/gws",
    "views/calendar.html",
    "views/gmail-thread.html",
    "views/jelly-view.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check && node scripts/check-copies.mjs && node scripts/check-icons.mjs && node scripts/check-forbidden.mjs && node scripts/check-workflows.mjs",
    "test": "vitest run",
    "test:host": "vitest run -c vitest.host.config.ts",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:tui": "bun --conditions=browser test/tui-renderer.mjs",
    "test:kit": "node --test scripts/release-kit.test.mjs",
    "fetch:gws": "node scripts/build-native.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:kit && npm run test:host && npm run test:pack && npm run generated:check && npm run test:tui",
    "generated:check": "node scripts/generate-docs.mjs --check",
    "manifest": "node scripts/generate-manifest.mjs",
    "drift": "node scripts/drift.mjs",
    "docs:coverage": "node scripts/generate-docs.mjs",
    "manifest:check": "node scripts/generate-manifest.mjs --check"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/biome": "2.6.4",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "24.19.2",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "jelly": {
    "title": "Google Workspace",
    "summary": "Gmail, Calendar, Drive, Docs and Sheets.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "gws.status",
        "permission": "gws.status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.catalog",
        "permission": "gws.catalog",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.schema",
        "permission": "gws.schema",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.read",
        "permission": "gws.read",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.plan",
        "permission": "gws.plan",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.events_list",
        "permission": "gws.events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "gws.write",
        "permission": "gws.write",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.export",
        "permission": "gws.export",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.send",
        "permission": "gws.send",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.share",
        "permission": "gws.share",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.delete",
        "permission": "gws.delete",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "gws.admin",
        "permission": "gws.admin",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "opencode-gws",
      "opencode-gws-recipes"
    ],
    "rpc": [
      {
        "name": "calendar.today",
        "label": "read today's calendar",
        "permission": "gws.read",
        "readOnly": true,
        "input": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account",
            "at",
            "state",
            "events"
          ],
          "properties": {
            "account": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "state": {
              "type": "string",
              "enum": [
                "ready",
                "stale"
              ]
            },
            "events": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "title",
                  "start",
                  "end"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "start": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "end": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "allDay": {
                    "type": "boolean"
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "joinUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        }
      }
    ],
    "views": [
      {
        "v": 1,
        "id": "gmail-thread",
        "place": "tool-result",
        "tools": [
          "gws_read"
        ],
        "title": "Gmail thread",
        "page": "views/gmail-thread.html",
        "grants": [
          "data"
        ]
      },
      {
        "v": 1,
        "id": "calendar-native",
        "place": "home-widget",
        "size": "m",
        "title": "Today",
        "page": "views/calendar.html",
        "grants": [
          "rpc"
        ],
        "rpc": [
          "calendar.today"
        ]
      }
    ],
    "nativeData": [
      {
        "v": 1,
        "capability": "calendar",
        "view": "calendar-native",
        "read": "calendar.today"
      }
    ],
    "signIns": [
      {
        "id": "google",
        "label": "Google Workspace",
        "integration": "gws-*",
        "relay": {
          "redirectField": "redirectUri",
          "portField": "callbackPort"
        },
        "account": {
          "option": "accounts",
          "label": "Account name",
          "description": "A short name for this Google account, such as work or personal. The agent names it on every call. It gets every Google service your sign-in can use; when you sign in you choose Read-only or Read and write.",
          "placeholder": "work",
          "value": {
            "mode": "interactive"
          }
        },
        "hostClient": {
          "id": "google",
          "field": "clientJson",
          "replaces": [
            "clientId",
            "clientSecret"
          ]
        },
        "needed": [
          "AUTH_REQUIRED",
          "AUTH_SCOPE_MISSING"
        ]
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "default": "all",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule; plan-then-commit still applies."
        }
      ]
    }
  },
  "memory": {
    "$schema": "https://raw.githubusercontent.com/joe-broadhead/opencode-mem/HEAD/plugin-kit/schema/memory-plugin.v2.json",
    "version": 2,
    "namespace": "gws",
    "connector": {
      "accounts": "multi",
      "identity": {
        "method": "events_list",
        "input": {
          "source": "gmail",
          "limit": 0
        },
        "grants": [
          {
            "action": "gws.events_list",
            "resource": "*"
          },
          {
            "action": "gws.read",
            "resource": "{account}:gmail.users.getProfile"
          },
          {
            "action": "gws.read",
            "resource": "{account}:gmail.users.history.list"
          },
          {
            "action": "gws.read",
            "resource": "{account}:gmail.users.messages.list"
          },
          {
            "action": "gws.read",
            "resource": "{account}:gmail.users.messages.get"
          }
        ],
        "account": "$.owner.id",
        "owner": {
          "id": "$.owner.id",
          "label": "$.owner.label"
        }
      },
      "reads": [
        {
          "method": "read",
          "input": {
            "operation": "calendar.events.list"
          },
          "grants": [
            {
              "action": "gws.read",
              "resource": "{account}:calendar.events.list"
            }
          ],
          "scopeInputs": {
            "calendarId": "calendars"
          },
          "kinds": [
            "meeting",
            "event"
          ],
          "cursor": "syncToken",
          "billing": null
        }
      ],
      "scope": [
        {
          "key": "calendars",
          "title": "Calendars",
          "kind": "ids",
          "pattern": "^(?:primary|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+)$",
          "max": 1,
          "required": false,
          "suggest": true
        }
      ],
      "billing": null
    },
    "sources": [
      {
        "id": "gmail",
        "title": "Gmail",
        "summary": "The messages in the signed-in mailbox.",
        "contract": 2,
        "kinds": [
          "message"
        ],
        "grants": [
          {
            "action": "gws.events_list",
            "resource": "*"
          },
          {
            "action": "gws.read",
            "resource": "{account}:gmail.users.getProfile"
          },
          {
            "action": "gws.read",
            "resource": "{account}:gmail.users.history.list"
          },
          {
            "action": "gws.read",
            "resource": "{account}:gmail.users.messages.list"
          },
          {
            "action": "gws.read",
            "resource": "{account}:gmail.users.messages.get"
          }
        ],
        "scope": [],
        "cadence": {
          "everyMinutes": 30
        },
        "billing": null,
        "setup": "Nothing to choose: events_list reads the whole signed-in Gmail mailbox."
      },
      {
        "id": "calendar",
        "title": "Calendar",
        "summary": "The events and cancellations of the primary calendar.",
        "contract": 2,
        "kinds": [
          "meeting",
          "event"
        ],
        "grants": [
          {
            "action": "gws.events_list",
            "resource": "*"
          },
          {
            "action": "gws.read",
            "resource": "{account}:calendar.calendarList.get"
          },
          {
            "action": "gws.read",
            "resource": "{account}:calendar.events.list"
          }
        ],
        "scope": [
          {
            "key": "calendars",
            "title": "Calendars",
            "kind": "ids",
            "pattern": "^(?:primary|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+)$",
            "max": 1,
            "required": false,
            "suggest": true
          }
        ],
        "cadence": {
          "everyMinutes": 30
        },
        "billing": null,
        "setup": "Choose the calendar to collect when you confirm; the primary calendar is the default."
      }
    ],
    "templates": [
      {
        "id": "gmail-commitments",
        "title": "Gmail commitments and people",
        "summary": "Commitments people make in the mailbox, proposed for review, with timeline lines on their person pages.",
        "source": "gmail",
        "extract": {
          "steps": [
            {
              "use": "events_list",
              "source": "gmail"
            }
          ]
        },
        "transform": {
          "into": "events",
          "map": {}
        },
        "curate": {
          "stages": [
            {
              "engine": "extract",
              "outputs": [
                "proposal:commitment_open",
                "proposal:commitment_close"
              ]
            },
            {
              "engine": "render",
              "into": "timeline",
              "line": "{title}: {count} messages {cite}",
              "max": 20
            }
          ]
        },
        "outputs": [
          "timeline"
        ],
        "budget": {
          "tokensPerRun": 15000
        }
      },
      {
        "id": "calendar-meetings",
        "title": "Calendar meeting pages",
        "summary": "A meeting page for each event, with its attendees as person links, and follow-ups proposed after it.",
        "source": "calendar",
        "extract": {
          "steps": [
            {
              "use": "events_list",
              "source": "calendar"
            }
          ]
        },
        "transform": {
          "into": "events",
          "map": {
            "external_id": "{{item.external_id}}",
            "kind": "meeting",
            "occurred_at": "{{item.occurred_at}}",
            "title": "{{item.title}}",
            "text": "{{item.text}}",
            "actors": "{{item.actors}}",
            "url": "{{item.url}}"
          }
        },
        "curate": {
          "stages": [
            {
              "engine": "render",
              "into": "section:Meetings",
              "line": "{title} at {first_at} {cite}",
              "max": 20
            },
            {
              "engine": "extract",
              "outputs": [
                "proposal:commitment_open"
              ]
            }
          ]
        },
        "outputs": [
          "timeline"
        ],
        "budget": {
          "tokensPerRun": 15000
        }
      }
    ]
  }
}
